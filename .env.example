AGENT_HOST=127.0.0.1
AGENT_PORT=3100
AGENT_REQUEST_TIMEOUT_MS=300000
AGENT_MAX_CONCURRENT_REQUESTS=1
# Limite de requisições por IP dentro da janela abaixo (opcional — cada um
# já tem um default sensato se omitido; ver agent/rate-limiter.js).
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX_REQUESTS=30

# Interpretação da pergunta e síntese de conteúdo de ticket, via Claude
# (API paga, console.anthropic.com) — ver agent/llm-client.js e
# agent/llm-router.js. Obrigatória: o servidor recusa subir sem ela.
# Nunca commitar a key de verdade.
ANTHROPIC_API_KEY=troque
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=20000

TICKETS_API_BASE_URL=https://troque.exemplo.com/api
TICKETS_API_TOKEN=troque
TICKETS_API_LOGIN=troque
TICKETS_API_APP=troque
TICKETS_API_TIMEOUT_MS=10000
# Ambas opcionais — já têm default sensato se omitidas (ver src/ticket-helpers.js).
# TTL do cache em memória dos catálogos (status/área/prioridade/canal/departamento/operador).
TICKETS_API_METADATA_CACHE_TTL_MS=300000
# Teto de chamadas concorrentes nas tools de resumo que contam 1 item de catálogo por vez.
TICKETS_API_FAN_OUT_CONCURRENCY=8
# Acima de quantos candidatos listar_tickets_vencidos recusa a rajada de checagem de SLA
# (1 chamada por ticket) e pede pra restringir o filtro.
TICKETS_API_SLA_CHECK_LIMIT=1000
